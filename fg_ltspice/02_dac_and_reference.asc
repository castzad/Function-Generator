TEXT -64 -400 Left 2 ;02  REFERENCE + DAC + I-to-V  (transient)\n;U5 REF3025 -> VREF_P (+2.5 V) -> U6B inverter (R6/R7) -> VREF_N (-2.5 V) -> U4 DAC7821 VREF\n;B_CODE stands in for the Teensy DMA writing D0..D11 at fs (2 MS/s, zero-order hold).\n;U6A + C16 turn the DAC current into DAC_OUT = 2.5 V x code / 4096.  D4 clamps IOUT1.\n;Change f, Vpk, Ksin/Ksq/Ktri (set exactly one to 1) on the .param line.
SYMBOL voltage 1100 -224 R0
SYMATTR InstName V_VAP
SYMATTR Value 8.2
SYMBOL voltage 1228 -224 R0
SYMATTR InstName V_VAN
SYMATTR Value 7.5
SYMBOL voltage 1356 -224 R0
SYMATTR InstName V_P5V
SYMATTR Value 5
